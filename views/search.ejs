                             fill="var(--sport-green)" transform="translate(-377.48 -340.75)"/>
                </svg>
             </div>
             <h1 style="font-size: 2rem; font-family: 'Signika', sans-serif; font-weight: 900; color: var(--text-white);">FantasyPL</h1>
        </div>
        <div class="title" style="display: flex; align-items: center; justify-content: center; margin-bottom: 25px;">
            <h2 style="color: var(--muted-gray); font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif; font-size: 1.75rem;">
                Register your FPL team
            </h2>
        </div>
        <section class="register" style="border-radius: 10px; box-shadow: 0 1px 2px 0 var(--text-white); height: 10%; width: 95%; background-image: linear-gradient(45deg, var(--card-bg-color), var(--card-light-gray-grad)); margin-inline: auto; ">
            <div class="reg" style="margin-top: 5px; display: flex; justify-content: center; align-items: center; height: 20%;">
                <h1 style="color: var(--neon-green); font-size: 1.5rem; font-weight: bold; font-family: 'Signika', sans-serif;">Search FPL Team</h1>
            </div>
            <form action="/register" method="post" style="display: flex; align-items: center; justify-content: center; height: 60%; background-color: transparent;">
                    <div class="input-box" style="background-color: transparent; height: 50%; width: 60%; display: flex; justify-content: center; align-items: center;">
                        <input type="number" name="id" placeholder="Enter League Id..." style="padding: 20px; border-radius: 20px 0 0 20px; background-color: var(--background-color); height: 100%; width: 90%; font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif; font-size: 1.2rem; color: var(--text-white); font-weight: bold;">
                    </div>
                    <button type="submit" style="background-color: var(--neon-green); height: 50%; width: 15%; border-radius: 0 20px 20px 0;" ><ion-icon name="search" style="font-size: 1.75rem; color: var(--background-color); font-weight: bold;"></ion-icon></button>
            </form>
            <div class="des" style="display: flex; justify-content: center; align-items: center; height: 20%;">
                <p style="color: var(--neon-red); font-style: italic; margin-bottom: 10px;">Pick a team from an Existing League</p>
            </div>
        </section>
        <div class="guide" style="padding-inline: 20px; display: flex; flex-flow: column nowrap; justify-content: center; align-items: center; margin-top: 30px;">
            
            <% if (locals.messages) { %>
                <p style="color: var(--neon-red); background-color: var(--text-white); text-align: center; border-radius: 4px; font-size: 1.2rem; font-style: italic; width: 80%;
                 font-weight: bold;"><%= messages %></p>
            <% } %>

            <h2 style="color: var(--sport-green); font-weight: bold; font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif; font-style: italic; font-size: 1.2rem; text-align: center;">
                 &lt;&lt; Access League Id from any Classic Leagues you have joined in the fpl site &gt;&gt; 
            </h2>
        </div>
        
    
    </main>
      
    <footer style="position: fixed; z-index: 2; bottom: 0; background-color: var(--background-color); width: 100vw; height: 10vh; display: flex; justify-content: space-evenly; align-items: center; border-top: 1px solid var(--card-light-gray-grad);">
        <a href="/main"><ion-icon name="home" style="color: var(--muted-gray); font-size: 3rem;"></ion-icon></a>

        <a href="/main">
            <div style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; margin-inline: 8px;">
