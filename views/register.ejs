m6-63.7a148 148 0 0 1-13.3 9.73v19.24c5.31 5.75 10.4 10.62 14.38 19.24 7.3-12.82 5.53-32.06-1.11-48.21Z"
                             fill="var(--sport-green)" transform="translate(-377.48 -340.75)"/>
                </svg>
            </div>
            <h1 style="font-weight: bold; font-size: 1.5rem; color: var(--sport-green); font-family: 'Signika', sans-serif;">League</h1>
        </div>

    </header>
    <main style=" width: 100vw; height: 190vh; background-color: transparent;">
        <section class="register" style="border-radius: 10px; height: 8%; width: 95%; background-image: linear-gradient(45deg, var(--card-bg-color), var(--card-light-gray-grad)); margin-inline: auto; ">
            <div class="reg" style="margin-top: 5px; display: flex; justify-content: center; align-items: center; height: 20%;">
                <h1 style="color: var(--neon-green); font-size: 1.2rem; font-weight: bold; font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;">
                    Search FPL Team
                </h1>
            </div>
            <form action="/register" method="post" style="display: flex; align-items: center; justify-content: center; height: 60%; background-color: transparent;">
                    <div class="input-box" style="background-color: transparent; height: 50%; width: 60%; display: flex; justify-content: center; align-items: center;">
                        <input type="number" name="id" placeholder="Enter League Id..." style="font-size: 1.2rem; color: var(--text-white); background-color: var(--background-color); font-family: 'Signika', sans-serif; font-weight: bold; padding: 20px; border-radius: 20px 0 0 20px; height: 100%; width: 90%;">
                    </div>
                    <button type="submit" style="background-color: var(--neon-green); height: 50%; width: 15%; border-radius: 0 20px 20px 0;" ><ion-icon name="search" style="font-size: 1.75rem; color: var(--background-color); font-weight: bold;"></ion-icon></button>
            </form>
            <div class="des" style="display: flex; justify-content: center; align-items: center; height: 20%;">
                <p style="color: var(--neon-red); font-weight: bold; margin-bottom: 10px;">Pick a team from an Existing League</p>
            </div>
        </section>
        <div class="results" style="display: flex; justify-content: center; align-items: center; margin-top: 20px;">
            <h1 style="color: var(--neon-green); font-weight: bold; font-size: 1.15rem; font-family: 'Signika', sans-serif;">Results</h1>
        </div>
        
        <section class="list" style="height: 210%; width: 100vw; background-color: transparent;">
                

              <% if ( managers.length > 0 ) { %>

                <% managers.map((manager) => { %>
                    <div class="cards">
                        <div class="entry" style="height: 100%; width: 75%; display: flex; flex-flow: column nowrap; justify-content: center; align-items: flex-start; padding: 20px;">
                            <h2 style="color: var(--text-white); font-weight: bold; font-size: 1.1rem; font-family: 'Signika' , sans-serif;"><%= manager.entry_name %></h2>
                            <p style="color: var(--neon-green); font-size: 1rem; font-style: italic; font-family: 'Signika', sans-serif; "><%= manager.player_first_name %> <span><%= manager.player_last_name %></span></p>
                        </div>
                        <div class="id" style="margin-right: 10px; width: 20%; height: 100%; display: flex; flex-flow: column nowrap; justify-content: center; align-items: center; background-color: transparent;">
                            <h4 style="font-size: .75rem; color: var(--muted-gray);"><%= manager.entry %></h4>
                            <p style="font-size: .7rem; color: var(--neon-red);">Team id</p>
                        </div>
                    </div>
                    <% }) %>

                    <% } %>
                
                       
                            
        </section>

    </main>
   
    <footer style="position: fixed; z-index: 2; bottom: 0; background-color: var(--background-color); width: 100vw; height: 10vh; display: flex; justify-content: space-evenly; align-items: center; border-top: 1px solid var(--card-light-gray-grad);">
     
         <a href="/main"><ion-icon name="home" style="color: var(--muted-gray); font-size: 3rem;"></ion-icon></a>

         <a href="/main">
            <div style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; margin-inline: 8px;">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 269.04 342.49">
                       <path d="M430.79 369.07a131.3 131.3 0 0 1 26.76 17c-.66-4-3.76-22.78-5.75-34.29 8.63 6 29.42 20.35 36.05 25 2.65-8.41 12.39-36.05 12.39-36.05s17.25 27.67 19.91 32.27c3.76-3.54 24.11-26.54 29.42-32.29 1.11 13.05 2 32.07 2.43 34.73a131.5 131.5 0 0 1 22.12-22.78c-5.75 11.28-8.41 26.76-9.73 39.37a147 147 0 0 0-40.7-5.75A150.8 150.8 0 0 0 448.92 406c-3.76-12.16-9.73-27.2-18.13-36.93m207.48 237.56-11.94-13.27c-3.32 35.61-21 66.14-53.09 87.37l-5.09-19.24c-27.43 19.69-74.1 32.29-114.36 9.73 5.09-25.44 9.29-51.32 0-82.28-22.34 34.29-42 48-42 48-15-25.44-13.71-76.09-9.29-91.13l-25 7.74c0-17 12.39-53.09 30.08-73.44l-15.26-2.43a148.3 148.3 0 0 1 46-54.64c-6 9.73-6 32.29 11.06 40.92-7.3-12.61-8-28.31-.66-36.72 7.74-8.41 20.35-5.31 28.31 1.11-2.43-7.08-9.73-15.93-19.91-16.59 19.91-10.4 43.13-15.93 67-15.93 4.65 0 9.07.44 13.27.66 7.08 2.65 17.25 12.61 22.12 19a35.1 35.1 0 0 0-3.76-15.93c26.1 6.41 38.71 17 43.8 22.12 1.11 11.28 4.42 17.92 9.07 28.76-8.41-9.29-29.64-24.77-40-28.31 0 0-1.11 9.73-4.42 14.38-20.35-14.6-30.08-18.36-30.08-18.36-22.56 2.21-36.5 11.06-44.46 17.7l6.64 5.75c-13.27 4-22.12 15.7-22.12 15.7 0 .44 11.94 2 11.94 2s-1.33 13.94 16.37 22.78c15 7.3 36.28-1.77 56.63 6.41-13.27-15.26-22.34-22.34-22.34-22.34a55.5 55.5 0 0 0-9.07-1.11c-4.65 0-11.72 1.11-19-2-3.76-1.33-8-4-11.06-6 0 0 9.29-9.73 23-11.72 0 0 12.39 3.32 22.12 10.62 6.41-6.41 13.27-6 13.27-6s-6.64 6.41-4.65 13.71a256 256 0 0 1 20.35 21c10.62-6 34.06-4.65 38.93 1.11-6-8-15-14.38-21.68-19.91-.66-3.1-8.41-13.27-9.29-14.38a45.9 45.9 0 0 1 13.27 7.74 16.85 16.85 0 0 1 9.73-6.41c4.65 4 5.75 10 5.31 11.06a12.84 12.84 0 0 1-4.42 3.76l11.28 12.39 1.11-9.07c26.27 37.48 40.65 81.06 22.29 135.69m-49.55-80.74v-19.24a61.8 61.8 0 0 1-17.92-10c-18.58 2.65-40.92 21.46-40.92 21.46s7.74 14.38 15.93 30.08c14.6 1.59 36.27-16.54 42.91-22.3m18.58 34.95a33.26 33.26 0 0 0-8-15.26L585 546s-19.69 16.59-31.41 17l10 18.58c6.64-1.33 17.92-6.64 22.78-11.94a68.4 68.4 0 0 1 2.43 21.68c6.55-4.15 15.62-14.32 18.5-30.48m6-63.7a148 148 0 0 1-13.3 9.73v19.24c5.31 5.75 10.4 10.62 14.38 19.24 7.3-12.82 5.53-32.06-1.11-48.21Z"
                             fill="var(--muted-gray)" transform="translate(-377.48 -340.75)"/>
                </svg>
            </div>
        </a>

      <!-- CONFIRM TEAM BOX -->
      
         <div class="formbox" style="display: none; border-radius: 20px; position: absolute; top: -280px; left: 50%; transform: translate(-50%, -50%); z-index: 3; height: 400px; width: 75vw; background-color: var(--card-bg-color); border: 1px solid var(--neon-green);">
                <div class="head-wrapper" style="width: 100%; height: 15%; position: relative;  background-color: transparent; border-radius: 20px 20px 0 0;">
                    <div class="icon-confirm" style="position: absolute; left: 0; height: 100%; width: 85%; padding: 10px; display: flex; justify-content: flex-start; align-items: center;">
                        <div style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; margin-inline: 8px;">
                             <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 269.04 342.49">
                               <path d="M430.79 369.07a131.3 131.3 0 0 1 26.76 17c-.66-4-3.76-22.78-5.75-34.29 8.63 6 29.42 20.35 36.05 25 2.65-8.41 12.39-36.05 12.39-36.05s17.25 27.67 19.91 32.27c3.76-3.54 24.11-26.54 29.42-32.29 1.11 13.05 2 32.07 2.43 34.73a131.5 131.5 0 0 1 22.12-22.78c-5.75 11.28-8.41 26.76-9.73 39.37a147 147 0 0 0-40.7-5.75A150.8 150.8 0 0 0 448.92 406c-3.76-12.16-9.73-27.2-18.13-36.93m207.48 237.56-11.94-13.27c-3.32 35.61-21 66.14-53.09 87.37l-5.09-19.24c-27.43 19.69-74.1 32.29-114.36 9.73 5.09-25.44 9.29-51.32 0-82.28-22.34 34.29-42 48-42 48-15-25.44-13.71-76.09-9.29-91.13l-25 7.74c0-17 12.39-53.09 30.08-73.44l-15.26-2.43a148.3 148.3 0 0 1 46-54.64c-6 9.73-6 32.29 11.06 40.92-7.3-12.61-8-28.31-.66-36.72 7.74-8.41 20.35-5.31 28.31 1.11-2.43-7.08-9.73-15.93-19.91-16.59 19.91-10.4 43.13-15.93 67-15.93 4.65 0 9.07.44 13.27.66 7.08 2.65 17.25 12.61 22.12 19a35.1 35.1 0 0 0-3.76-15.93c26.1 6.41 38.71 17 43.8 22.12 1.11 11.28 4.42 17.92 9.07 28.76-8.41-9.29-29.64-24.77-40-28.31 0 0-1.11 9.73-4.42 14.38-20.35-14.6-30.08-18.36-30.08-18.36-22.56 2.21-36.5 11.06-44.46 17.7l6.64 5.75c-13.27 4-22.12 15.7-22.12 15.7 0 .44 11.94 2 11.94 2s-1.33 13.94 16.37 22.78c15 7.3 36.28-1.77 56.63 6.41-13.27-15.26-22.34-22.34-22.34-22.34a55.5 55.5 0 0 0-9.07-1.11c-4.65 0-11.72 1.11-19-2-3.76-1.33-8-4-11.06-6 0 0 9.29-9.73 23-11.72 0 0 12.39 3.32 22.12 10.62 6.41-6.41 13.27-6 13.27-6s-6.64 6.41-4.65 13.71a256 256 0 0 1 20.35 21c10.62-6 34.06-4.65 38.93 1.11-6-8-15-14.38-21.68-19.91-.66-3.1-8.41-13.27-9.29-14.38a45.9 45.9 0 0 1 13.27 7.74 16.85 16.85 0 0 1 9.73-6.41c4.65 4 5.75 10 5.31 11.06a12.84 12.84 0 0 1-4.42 3.76l11.28 12.39 1.11-9.07c26.27 37.48 40.65 81.06 22.29 135.69m-49.55-80.74v-19.24a61.8 61.8 0 0 1-17.92-10c-18.58 2.65-40.92 21.46-40.92 21.46s7.74 14.38 15.93 30.08c14.6 1.59 36.27-16.54 42.91-22.3m18.58 34.95a33.26 33.26 0 0 0-8-15.26L585 546s-19.69 16.59-31.41 17l10 18.58c6.64-1.33 17.92-6.64 22.78-11.94a68.4 68.4 0 0 1 2.43 21.68c6.55-4.15 15.62-14.32 18.5-30.48m6-63.7a148 148 0 0 1-13.3 9.73v19.24c5.31 5.75 10.4 10.62 14.38 19.24 7.3-12.82 5.53-32.06-1.11-48.21Z"
                                fill="var(--sport-green)" transform="translate(-377.48 -340.75)"/>
                             </svg>
                        </div>
                        <h2 style="color: var(--muted-gray); font-family: 'Signika', sans-serif;">FantasyPL Team</h2>
                    </div>
                    <div class="close" style="display: flex; justify-content: center; align-items: center; background-color: var(--neon-red); position: absolute; right: 0; height: 100%; width: 15%; border-radius: 0 20px 0 20px;">
                        <ion-icon name="close" style="font-size: 2rem; color: var(--text-white); font-weight: bold;"></ion-icon>
                    </div>
                </div>
                <div class="details-wrapper" style="height: 60%;">
                    <div class="dets" style="height: 35%; background-color: transparent; display: flex; flex-flow: column nowrap; align-items: center; justify-content: center; ">
                        <h2 id="team" style="font-style: italic; font-family: 'Signika', sans-serif; font-size: 1.4rem; color: var(--text-white);"></h2>
                        <p style="font-style: italic; color: var(--neon-red); font-size: 1.15rem;" >team</p>
                    </div>
                    <div class="dets" style="height: 35%; background-color: transparent; display: flex; flex-flow: column nowrap; justify-content: center; align-items: center; "> 
                        <h2 id="manager" style="font-style: italic; font-family: 'Signika', sans-serif; font-size: 1.4rem; color: var(--text-white);"></h2>
                        <p style="font-style: italic; color: var(--neon-red); font-size: 1.05rem;">manager</p>
                    </div>
                    <div class="dets" style="height: 30%; background-color: transparent;  display: flex; flex-flow: column nowrap; justify-content: center; align-items: center; ">
                        <h3 id="code" style="font-style: italic; color: var(--muted-gray);"></h3>
                        <p style="font-style: italic; color: var(--neon-red); font-size: 1.15rem;">id</p>
                    </div>
                   
                </div>
                <div class="confirm-btn" style="background-color: transparent; border: 1px solid var(--neon-green); border-radius: 0 0 20px 20px; height: 25%; width: 100%; display: flex; align-items: center; justify-content: center;">
                    <form action="/patchId?_method=PATCH" method="post" style="height: 70%; width: 60%; background-color: transparent;">
                        <input type="number" name="teamid" id="teamid" style="display: none;">
                        <button type="submit" style="height: 100%; width: 100%; border-radius: 40px; background-color: var(--sport-green); color: var(--background-color); font-weight: bold; border: none; outline: none; font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif; font-size: 1rem;">
                            CONFIRM
                        </button>
                    </form>
                
                </div>
                
         </div>

    </footer>
   

    <script>
        const section = document.querySelector('.list')
        const form = document.querySelector('.formbox')
        const closeBtn = document.querySelector('.close')
        const codeText = document.getElementById('code')
        const teamName = document.getElementById('team')
        const player = document.getElementById('manager') 
        const input = document.getElementById('teamid')
        const buttons = document.querySelectorAll('.cards')
        buttons.forEach((button) => {
            button.addEventListener('click', (id) => {
                button.id == id
                form.style.display = 'block'
                codeText.value = button.children[1].children[0].textContent
                input.value = button.children[1].children[0].textContent
                codeText.textContent = codeText.value
                teamName.textContent = button.children[0].children[0].textContent
                player.textContent = button.children[0].children[1].textContent
                section.style.display = 'none'
            
            })
        })
        closeBtn.addEventListener('click', () => {
               form.style.display = 'none'
               section.style.display = 'block'
        })

    </script>
</body>
</html>