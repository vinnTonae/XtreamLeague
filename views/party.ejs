<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="logos/plicon.png" type="images/x-icon" width="40" height="40">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Signika:wght@300..700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Calistoga&family=Josefin+Sans:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">
    <title>Party</title>
    <script type="module" src="https://unpkg.com/ionicons@4.5.10-0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule="" src="https://unpkg.com/ionicons@4.5.10-0/dist/ionicons/ionicons.js"></script>
    <style>

        * {
            margin: 0;
            border: 0;
            box-sizing: border-box;
        }
        
          :root {
          --background-color: #121212;
          --card-bg-color: #212121;
          --card-light-gray-grad: #535353;
          --neon-green: #1ed760;
          --sport-green: #1db954;
          --text-white: #FFFFFF;
          --muted-gray: #B3B3B3;
          --neon-red: #FF073A;
        }

        .managers {
            display: flex;
            margin-inline: auto;
            border-radius: 20px;
            background-color: var(--background-color);
            flex-flow: column nowrap;
            scroll-snap-type: inline mandatory;
            scroll-padding-inline: 15px;
            overflow-x: hidden;
            overflow-y: scroll;
        }
        .cards {
            height: 30px;
            width: 93%;
            border-radius: 5px 40px 40px 5px;
            cursor: pointer;
            text-decoration: none;
            box-shadow: 0 1px 2px 0 var(--neon-green);
            margin: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: var(--card-light-gray-grad);
            scroll-snap-align: start;
        }
        ::-webkit-scrollbar {
            display: none;
        }
    </style>    
</head>
<body style="height: 100svh; position: relative; background: var(--background-color);">
       
          <!-- PATCH BOX FOR OPPONENT -->
   
          <div class="formbox" style="display: none; border-radius: 20px; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 3; height: 400px; width: 75vw; background-color: var(--card-bg-color); border: 1px solid var(--neon-green);">
            <div class="head-wrapper" style="width: 100%; height: 15%; position: relative; background-color: transparent; border-radius: 20px 20px 0 0;">
                <div class="icon-confirm" style="position: absolute; left: 0; height: 100%; width: 85%; padding: 10px; display: flex; justify-content: flex-start; align-items: center;">
                    <div style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; margin-inline: 8px;">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 269.04 342.49">
                        <path d="M430.79 369.07a131.3 131.3 0 0 1 26.76 17c-.66-4-3.76-22.78-5.75-34.29 8.63 6 29.42 20.35 36.05 25 2.65-8.41 12.39-36.05 12.39-36.05s17.25 27.67 19.91 32.27c3.76-3.54 24.11-26.54 29.42-32.29 1.11 13.05 2 32.07 2.43 34.73a131.5 131.5 0 0 1 22.12-22.78c-5.75 11.28-8.41 26.76-9.73 39.37a147 147 0 0 0-40.7-5.75A150.8 150.8 0 0 0 448.92 406c-3.76-12.16-9.73-27.2-18.13-36.93m207.48 237.56-11.94-13.27c-3.32 35.61-21 66.14-53.09 87.37l-5.09-19.24c-27.43 19.69-74.1 32.29-114.36 9.73 5.09-25.44 9.29-51.32 0-82.28-22.34 34.29-42 48-42 48-15-25.44-13.71-76.09-9.29-91.13l-25 7.74c0-17 12.39-53.09 30.08-73.44l-15.26-2.43a148.3 148.3 0 0 1 46-54.64c-6 9.73-6 32.29 11.06 40.92-7.3-12.61-8-28.31-.66-36.72 7.74-8.41 20.35-5.31 28.31 1.11-2.43-7.08-9.73-15.93-19.91-16.59 19.91-10.4 43.13-15.93 67-15.93 4.65 0 9.07.44 13.27.66 7.08 2.65 17.25 12.61 22.12 19a35.1 35.1 0 0 0-3.76-15.93c26.1 6.41 38.71 17 43.8 22.12 1.11 11.28 4.42 17.92 9.07 28.76-8.41-9.29-29.64-24.77-40-28.31 0 0-1.11 9.73-4.42 14.38-20.35-14.6-30.08-18.36-30.08-18.36-22.56 2.21-36.5 11.06-44.46 17.7l6.64 5.75c-13.27 4-22.12 15.7-22.12 15.7 0 .44 11.94 2 11.94 2s-1.33 13.94 16.37 22.78c15 7.3 36.28-1.77 56.63 6.41-13.27-15.26-22.34-22.34-22.34-22.34a55.5 55.5 0 0 0-9.07-1.11c-4.65 0-11.72 1.11-19-2-3.76-1.33-8-4-11.06-6 0 0 9.29-9.73 23-11.72 0 0 12.39 3.32 22.12 10.62 6.41-6.41 13.27-6 13.27-6s-6.64 6.41-4.65 13.71a256 256 0 0 1 20.35 21c10.62-6 34.06-4.65 38.93 1.11-6-8-15-14.38-21.68-19.91-.66-3.1-8.41-13.27-9.29-14.38a45.9 45.9 0 0 1 13.27 7.74 16.85 16.85 0 0 1 9.73-6.41c4.65 4 5.75 10 5.31 11.06a12.84 12.84 0 0 1-4.42 3.76l11.28 12.39 1.11-9.07c26.27 37.48 40.65 81.06 22.29 135.69m-49.55-80.74v-19.24a61.8 61.8 0 0 1-17.92-10c-18.58 2.65-40.92 21.46-40.92 21.46s7.74 14.38 15.93 30.08c14.6 1.59 36.27-16.54 42.91-22.3m18.58 34.95a33.26 33.26 0 0 0-8-15.26L585 546s-19.69 16.59-31.41 17l10 18.58c6.64-1.33 17.92-6.64 22.78-11.94a68.4 68.4 0 0 1 2.43 21.68c6.55-4.15 15.62-14.32 18.5-30.48m6-63.7a148 148 0 0 1-13.3 9.73v19.24c5.31 5.75 10.4 10.62 14.38 19.24 7.3-12.82 5.53-32.06-1.11-48.21Z"
                             fill="var(--sport-green)" transform="translate(-377.48 -340.75)"/>
                      </svg>
                    </div>
                    <h2 style="color: var(--muted-gray); margin-left: 5px; font-family: 'Signika', sans-serif;">Confirm Bet</h2>
                </div>
                <div class="close" style="display: flex; justify-content: center; align-items: center; background-color: var(--neon-red); position: absolute; right: 0; height: 100%; width: 15%; border-radius: 0 20px 0 20px;">
                    <ion-icon name="close" style="font-size: 2rem; color: var(--text-white); font-weight: bold;"></ion-icon>
                </div>
            </div>
            <div class="details-wrapper" style="height: 60%; padding-block: 10px; display: flex; flex-wrap: wrap; justify-content: center; align-items: center;">
              
                  <!-- CONFIRM OR DENY DETAILS BOX -->
    
                  <section class="confirm-details" style=" padding-top: 20px; background-color: transparent;  width: 100%; height: 100%;">
                         <h1 style="color: var(--text-white); text-align: center; margin: 10px auto; font-size: 1.8rem; font-family: 'Signika', sans-serif; font-weight: bold;">
                            Party
                         </h1>
                         <h1 style="color: var(--muted-gray); text-align: center; margin: 10px auto; font-size: 1.5rem; font-family: 'Signika', sans-serif; font-weight: bold;"><span style="color: var(--neon-red); font-size: 1.2rem;">host: </span><%= host.teamName %></h1>
                         <h1 style="color: var(--muted-gray); text-align: center; margin: 10px auto; font-family: 'Signika', sans-serif; font-size: 1.5rem; font-weight: bold;"><span style="color: var(--neon-red); font-size: 1.2rem;">event: </span>GW<%= party.event %></h1>
                         <h1 style="color: var(--muted-gray); text-align: center; margin: 10px auto; font-size: 1.5rem; font-weight: bold;"><span style="color: var(--neon-red); font-size: 1.2rem;">amount: </span>KSH <%= party.amount %></h1>

                         
                  </section>
    
     
            </div>
            <div class="confirm-btn" style="border: 1px solid var(--neon-green); border-radius: 0 0 20px 20px; height: 25%; width: 100%; display: flex; align-items: center; justify-content: center;">
                <form action="/confirm-party?_method=PATCH" method="post" style="height: 60%; width: 60%; margin-bottom: 20px; background-color: transparent;">
                    <input type="text" name="betid" id="type" style="display: none;">
                    
                    <button id="submit" type="submit" style="height: 100%; width: 100%; border-radius: 40px; background-color: var(--sport-green); color: var(--background-color); border: none; outline: none; cursor: pointer; font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif; font-size: 1rem;">
                        CONFIRM
                    </button>
                </form>
            
            </div>
            
     </div>


    <header style="height: 10svh; width: 100vw; background-color: var(--background-color); display: flex; align-items: center; justify-content: space-between;">
        <a href="/parties/<%= party.event %>" style="text-decoration: none; margin-left: 5px; display: flex; align-items: center; justify-content: center;">
            <ion-icon name="arrow-round-back" style="font-weight: bold; color: var(--muted-gray); font-size: 2rem;"></ion-icon>
            <h1 style="text-decoration: none; margin-inline: 3px; font-weight: bold; font-family: 'Signika', sans-serif; font-size: 1.75rem; color: var(--muted-gray);">Party</h1>
        </a>
        <div class="account" style="height: 70%; display: flex; justify-content: flex-end; align-items: center;">
            <div class="balance" style="width: 100%; height: 100%; padding-inline: 5px;  margin-right: 15px; display: flex; align-items: center; justify-content: space-evenly; background-color: var(--card-bg-color); border-radius: 10px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" style="fill: var(--neon-green);transform: msFilter"><path d="M12 15c-1.84 0-2-.86-2-1H8c0 .92.66 2.55 3 2.92V18h2v-1.08c2-.34 3-1.63 3-2.92 0-1.12-.52-3-4-3-2 0-2-.63-2-1s.7-1 2-1 1.39.64 1.4 1h2A3 3 0 0 0 13 7.12V6h-2v1.09C9 7.42 8 8.71 8 10c0 1.12.52 3 4 3 2 0 2 .68 2 1s-.62 1-2 1z"></path><path d="M5 2H2v2h2v17a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V4h2V2H5zm13 18H6V4h12z"></path></svg>
                <h2 style="color: var(--text-white); margin-inline: 5px;  font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif; font-weight: bold; text-wrap: nowrap;">KES <%= userData.totalBalance %></h2>
            </div>
            
        </div>
        
    </header>

<main style="height: 90svh; width: clamp(300px, 95%, 800px); position: absolute; left: 50%; transform: translateX(-50%); border: 3px dotted var(--muted-gray); background: var(--card-bg-color);">
        
        <section class="bet-type" style="width: 100%; height: 8vh; background-color: transparent; display: flex; justify-content: center; align-items: center;">
            <h1 style="font-size: 2rem; font-family: 'Signika', sans-serif; font-weight: bold; text-align: center; color: var(--text-white);">Party</h1>
        </section>

        <section class="host" style="width: 100%; height: 4vh; display: flex; align-items: center; justify-content: flex-start;">
            <h3 style="margin-left: 10px; text-wrap: nowrap; color: var(--muted-gray);"><span style="color: var(--neon-red); font-size: .9rem;">host: </span><%= host.userName %></h3> 
            
             
        </section>

        <section class="webshare" style="width: 100%; height: 6vh; margin-block: 10px; display: flex; align-items: center; justify-content: center;">
             
            <h3 style="margin-right: 10px; font-size: .9rem; font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif; font-weight: bold; color: var(--muted-gray);">
                Party Code
            </h3> 
             
            <div class="code-box" style="width: 45%; height: 90%; padding-inline: 5px; border-radius: 10px 0 0 10px; border: 1px solid var(--muted-gray); background-color: var(--card-bg-color); color: var(--text-white); display: flex; align-items: center; justify-content: center; text-align: center;">
                <p id="betid" style="font-size: .75rem; text-wrap: wrap; text-align: center;"><%= party._id %></p>
            </div>

             <button class="share" style="outline: none; border: none; height: 90%; width: 12.5%; border-radius: 0 10px 10px 0 ; margin: 0 50px 0 10px; background-color: var(--sport-green); display: flex; justify-content: center; align-items: center;">
                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" style="fill: var(--background-color);transform: msFilter"><path d="M5.5 15a3.51 3.51 0 0 0 2.36-.93l6.26 3.58a3.06 3.06 0 0 0-.12.85 3.53 3.53 0 1 0 1.14-2.57l-6.26-3.58a2.74 2.74 0 0 0 .12-.76l6.15-3.52A3.49 3.49 0 1 0 14 5.5a3.35 3.35 0 0 0 .12.85L8.43 9.6A3.5 3.5 0 1 0 5.5 15zm12 2a1.5 1.5 0 1 1-1.5 1.5 1.5 1.5 0 0 1 1.5-1.5zm0-13A1.5 1.5 0 1 1 16 5.5 1.5 1.5 0 0 1 17.5 4zm-12 6A1.5 1.5 0 1 1 4 11.5 1.5 1.5 0 0 1 5.5 10z"></path></svg>
             </button>
        </section>
        
        <section class="pool-details" style="width: 100%; height: 5vh; display: flex; align-items: center; justify-content: space-between; padding-inline: 5px;">
            <h3 style="font-weight: bold; color: var(--muted-gray); font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;">Total players: <span style="color: var(--text-white);"><%= players.length %></span></h3>
            <h3 style="font-weight: bold; color: var(--muted-gray); font-family: 'Signika', sans-serif; margin-right: 15px;">Winners: <span style="color: var(--text-white);"><%= toWin %></span></h3>
        </section>

        <section class="managers" style="width: 95%; height: 25vh;  justify-content: flex-start; align-items: flex-start;" >
             
            

             <% players.map((player) => { %> 


                <% if (player.teamId == host.teamId) { %>
                                 <!-- RENDER MULTIPLE AFTER PEOPLE JOIN PARTY -->
            <a href="/myteam/<%= player.teamId %>/<%= party.event %>" class="cards" style="background-color: var(--sport-green); pointer-events: none; box-shadow: 0 1px 2px 0 var(--text-white);">
                <div class="entry" style="height: 100%;  display: flex; flex-flow: column nowrap; justify-content: center; align-items: center; padding: 20px;">
                    <h2 style="font-size: .85rem; font-weight: bold; font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif; font-style: italic; color: var(--background-color);"><%= player.teamName %></h2>
                </div>
                <div class="id" style="margin-right: 10px; width: 20%; height: 100%; display: flex; flex-flow: column nowrap; justify-content: center; align-items: center; background-color: transparent;">
                    <p style="font-style: italic; font-weight: bold; font-size: .95rem; color: var(--neon-red); display: block;">host</p>
                </div>
                <div class="points" style=" height: 100%; margin-left: 5px; background-color: transparent; display: flex; justify-content: center; align-items: center; ">
                    
                    <h2 style="font-weight: bold; font-size: .85rem; color: var(--background-color); margin-right: 5px; font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;"><%= player.points %></h2>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" style="fill: var(--text-white);transform: msFilter"><path d="M3 19h18a1.002 1.002 0 0 0 .823-1.569l-9-13c-.373-.539-1.271-.539-1.645 0l-9 13A.999.999 0 0 0 3 19z"></path></svg>
                 </div>       
                </a>
      
                  <% } else { %>

                               <!-- RENDER MULTIPLE AFTER PEOPLE JOIN PARTY -->
            <a href="/myteam/<%= player.teamId %>/<%= party.event %>" class="cards" style="pointer-events: none;">
                <div class="entry" style="height: 100%;  display: flex; flex-flow: column nowrap; justify-content: center; align-items: center; padding: 20px;">
                    <h2 style="font-size: .85rem; font-weight: bold; font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif; font-style: italic; color: var(--text-white);"><%= player.teamName %></h2>
                </div>
                <div class="id" style="margin-right: 10px; width: 20%; height: 100%; display: flex; flex-flow: column nowrap; justify-content: center; align-items: center; background-color: transparent;">
                    <p style="font-size: .7rem; color: var(--muted-gray); display: block;"><%= player.teamId %></p>
                </div>
                <div class="points" style=" height: 100%; margin-left: 5px; background-color: transparent; display: flex; justify-content: center; align-items: center; ">
                    
                    <h2 style="font-weight: bold; font-size: .85rem; margin-right: 5px; font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif; color: var(--text-white);"><%= player.points %></h2>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" style="fill: var(--neon-green);transform: msFilter"><path d="M3 19h18a1.002 1.002 0 0 0 .823-1.569l-9-13c-.373-.539-1.271-.539-1.645 0l-9 13A.999.999 0 0 0 3 19z"></path></svg>
                </div>       
            </a>
      

                  <%  } %>

                    
                <%  })  %>
            
         
        </section>

        <section class="winners" style="height: 10vh; width: 100%; background-color: var(--card-bg-color); display: flex; align-items: center; justify-content: space-evenly;">

            <% const totalPlayers = players.length %>

            <% if (totalPlayers <= 5) { %>


                <div class="first" style="width: fit-content; display: flex; flex-flow: column nowrap; align-items: center; justify-content: center;">
    
                    <h2 style="font-size: .95rem; font-weight: bold; font-family: 'Signika', sans-serif; color: var(--text-white);"><%= firstObject.teamName %></h2>
                    <h3 id="first" style="font-size: .9rem; margin-left: 10px; color: var(--neon-green);"><span style="color: var(--muted-gray); font-weight: bold; font-family: 'Signika', sans-serif;">1st: </span>KES.<%= winners[0] %></h3>
    
                 </div>
    
                 <div class="second" style="width: fit-content; display: none; flex-flow: column nowrap; align-items: center; justify-content: center;">
    
                    <h2 style="font-size: .95rem; font-weight: bold; font-family: 'Signika', sans-serif; color: var(--text-white);"><%= secondObject.teamName %></h2>
                    <h3 id="second" style="font-size: .9rem; margin-left: 10px; color: var(--neon-green);"><span style="color: var(--muted-gray); font-weight: bold; font-family: 'Signika', sans-serif;">2nd: </span>KES.<%= winners[1] %></h3>
    
                 </div>
    
                 <div class="third" style="width: fit-content; display: none; flex-flow: column nowrap; align-items: center; justify-content: center;">
    
                    <h2 style="font-size: .95rem; font-weight: bold; font-family: 'Signika', sans-serif; color: var(--text-white);"><%= thirdObject.teamName %></h2>
                    <h3 id="third" style="font-size: .9rem; margin-left: 10px; color: var(--neon-green);"> <span style="color: var(--muted-gray); font-weight: bold; font-family: 'Signika', sans-serif;">3rd: </span>KES.<%= winners[2] %></h3>
    
                 </div>

            <% } else if (6 <= totalPlayers <= 10) { %>

                <div class="first" style="width: fit-content; display: flex; flex-flow: column nowrap; align-items: center; justify-content: center;">
    
                    <h2 style="font-size: .95rem; font-weight: bold; font-family: 'Signika', sans-serif; color: var(--text-white);"><%= firstObject.teamName %></h2>
                    <h3 id="first" style="font-size: .9rem; margin-left: 10px; color: var(--neon-green);"><span style="color: var(--muted-gray); font-weight: bold; font-family: 'Signika', sans-serif;">1st: </span>KES.<%= winners[0] %></h3>
    
                 </div>
    
                 <div class="second" style="width: fit-content; display: flex; flex-flow: column nowrap; align-items: center; justify-content: center;">
    
                    <h2 style="font-size: .95rem; font-weight: bold; font-family: 'Signika', sans-serif; color: var(--text-white);"><%= secondObject.teamName %></h2>
                    <h3 id="second" style="font-size: .9rem; margin-left: 10px; color: var(--neon-green);"><span style="color: var(--muted-gray); font-weight: bold; font-family: 'Signika', sans-serif;">2nd: </span>KES.<%= winners[1] %></h3>
    
                 </div>
    
                 <div class="third" style="width: fit-content; display: none; flex-flow: column nowrap; align-items: center; justify-content: center;">
    
                    <h2 style="font-size: .95rem; font-weight: bold; font-family: 'Signika', sans-serif; color: var(--text-white);"><%= thirdObject.teamName %></h2>
                    <h3 id="third" style="font-size: .9rem; margin-left: 10px; color: var(--neon-green);"> <span style="color: var(--muted-gray); font-weight: bold; font-family: 'Signika', sans-serif;">3rd: </span>KES.<%= winners[2] %></h3>
    
                 </div>
                 
                 <% } else if (totalPlayers > 10) { %>
                    
                    <div class="first" style="width: fit-content; display: flex; flex-flow: column nowrap; align-items: center; justify-content: center;">
        
                        <h2 style="font-size: .95rem; font-weight: bold; font-family: 'Signika', sans-serif; color: var(--text-white);"><%= firstObject.teamName %></h2>
                        <h3 id="first" style="font-size: .9rem; margin-left: 10px; color: var(--neon-green);"><span style="color: var(--muted-gray); font-weight: bold; font-family: 'Signika', sans-serif;">1st: </span>KES.<%= winners[0] %></h3>
        
                     </div>
        
                     <div class="second" style="width: fit-content; display: flex; flex-flow: column nowrap; align-items: center; justify-content: center;">
        
                        <h2 style="font-size: .95rem; font-weight: bold; font-family: 'Signika', sans-serif; color: var(--text-white);"><%= secondObject.teamName %></h2>
                        <h3 id="second" style="font-size: .9rem; margin-left: 10px; color: var(--neon-green);"><span style="color: var(--muted-gray); font-weight: bold; font-family: 'Signika', sans-serif;">2nd: </span>KES.<%= winners[1] %></h3>
        
                     </div>
        
                     <div class="third" style="width: fit-content; display: flex; flex-flow: column nowrap; align-items: center; justify-content: center;">
        
                        <h2 style="font-size: .95rem; font-weight: bold; font-family: 'Signika', sans-serif; color: var(--text-white);"><%= thirdObject.teamName %></h2>
                        <h3 id="third" style="font-size: .9rem; margin-left: 10px; color: var(--neon-green);"> <span style="color: var(--muted-gray); font-weight: bold; font-family: 'Signika', sans-serif;">3rd: </span>KES.<%= winners[2] %></h3>
        
                     </div>

            <% } %>

       
           
    
        </section>

        <section class="event" style="width: 100%; height: 5vh; display: flex; align-items: center; justify-content: center;">

            <h1 id="event" style="font-size: 1.4rem; font-family: 'Signika', sans-serif; font-weight: bold; text-align: center; color: var(--muted-gray);">Gameweek <%= party.event %></h1>

        </section>

        <section class="amount" style="position: relative; width: 100%; height: 7vh; background-color: var(--card-light-gray-grad); display: flex; justify-content: center; align-items: center;">
            <div class="entry" style="height: 100%; width: 50%; display: flex; align-items: center; justify-content: center; flex-flow: column nowrap;">
                 <p id="amount" style="color: var(--neon-red); margin: 0; font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif; font-size: 1.2rem; font-weight: bold;">KES.<%= party.amount %></p>
                 <p style="margin: 5px; font-style: italic; font-size: .95rem; color: var(--muted-gray); ">entry fee</p>
            </div>
            <div class="winner" style="height: 100%; width: 50%; display: flex; justify-content: center; align-items: center; flex-flow: column nowrap;">
                <p style="color: var(--neon-green); margin: 0; font-weight: bold; font-size: 1.1rem;">Top players</p>
                <p style="margin: 5px; font-style: italic; font-size: .95rem; color: var(--muted-gray);">Win</p>
            </div>
            
             <div class="arrow" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
                 <svg xmlns="http://www.w3.org/2000/svg" width="45" height="24" viewBox="0 0 24 24" style="fill: var(--muted-gray);transform: msFilter"><path d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"></path></svg>
             </div>
            
         </section>
           
         <% if ( party.betStatus.code === 1000 || party.betStatus.code === 400 ) { %>

            <section class="join-btn" style="width: 100%; height: 10vh; margin-bottom: 5px; display: flex; align-items: center; justify-content: center;">
                
                <h3 style="color: var(--sport-green); font-weight: bold; font-family: 'Signika', sans-serif; font-size: 1.5rem;">Party Closed</h3>
    
            </section>  

           <% } else { %> 
     
            
           <% if (host.teamId == userData.teamId)  { %>
                
            <section class="join-btn" style="width: 100%; height: 10vh; margin-bottom: 5px; display: flex; align-items: center; justify-content: center;">
                
                <h3 style="font-weight: bold; font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif; font-size: 1.5rem; color: var(--text-white);">&lt;&lt;You are the Host&gt;&gt;</h3>
    
            </section>   
            
            <% } else if ( party.players.includes(userData.teamId) ) { %>

                <section class="join-btn" style="width: 100%; height: 10vh; margin-bottom: 5px; display: flex; align-items: center; justify-content: center;">
                    
                    <h3 style="font-weight: bold; font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif; font-size: 1.5rem; color: var(--text-white);">&lt;&lt;You Joined Party&gt;&gt;</h3>
        
                </section>   
                
             <% } else {  %>
               
            <section class="join-btn" style="width: 100%; height: 10vh; margin-bottom: 5px; display: flex; align-items: center; justify-content: center;">

                    <button id="join" style="height: 80%; width: 45%; cursor: pointer; font-weight: bold; font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif; font-size: 1.4rem; border: 2px solid var(--text-white); outline: none; border-radius: 20px; color: var(--background-color); background-color: var(--sport-green); " >
                        Join Party
                    </button>
        
            </section>

             <% } %>

        <% } %>
        
              <section class="status" style="width: 100%; height: 8vh; display: flex; justify-content: center; align-items: center;">
                <h3 style="font-size: .9rem; margin-right: 10px; font-weight: bold; color: var(--muted-gray);">status:</h3>
                <h3 style="font-size: .95rem; font-style: italic; font-family: 'Signika', sans-serif; font-weight: bold; color: var(--neon-red);">"<%= party.betStatus.message %>"</h3>       
          
              </section>

    </main>   

    <script>
       
       const joinBtn = document.getElementById('join')
       const formBox = document.querySelector('.formbox')
       const inputPartyId = document.getElementById('type')
       const code = document.querySelector('#betid').textContent
       const event = document.querySelector('#event').textContent
       const amount = document.querySelector('#amount').textContent
       const closeBtn = document.querySelector('.close')
       const codeElem = document.querySelector('#betid')
       const submitBtn = document.getElementById('submit') 
       const shareBtn = document.querySelector('.share')
       
       shareBtn.addEventListener('click', () => {

           if( navigator.share ) {
               navigator.share({
                title: 'XtreamLeague',
                url: `https://xtreamleague.onrender.com/party/${code}`,
                text: `Hi there,\nJoin my ${event} party and compete with other FPL Managers. Entry fee is ${amount} use link https://xtreamleague.onrender.com/party/${code} or use code ${code} in the site`
               })
           } else {
            navigator.clipboard.writeText(code)
            window.alert('code copied to clipboard')
           }
       })
       
       joinBtn.addEventListener('click', () => {

           inputPartyId.value = codeElem.textContent
           formBox.style.display = 'block'
        

       })

       closeBtn.addEventListener('click', () => {
            formBox.style.display = 'none'
       })



    </script>
    
    
</body>
    

</html>