<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="logos/plicon.png" type="images/x-icon" width="40" height="40">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Signika:wght@300..700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Calistoga&family=Josefin+Sans:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">
    <title>XtreamBets</title>
    <script type="module" src="https://unpkg.com/ionicons@4.5.10-0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule="" src="https://unpkg.com/ionicons@4.5.10-0/dist/ionicons/ionicons.js"></script>
    <style>
        * {
            margin: 0;
            border: 0;
            box-sizing: border-box;
        }
        
        :root {
          --background-color: #121212;
          --card-bg-color: #212121;
          --card-light-gray-grad: #535353;
          --neon-green: #1ed760;
          --sport-green: #1db954;
          --text-white: #FFFFFF;
          --muted-gray: #B3B3B3;
          --neon-red: #FF073A;
        }
        
        ::-webkit-scrollbar {
            height: 1rem;
            width: 1rem;
        }

        ::-webkit-scrollbar-track {
            background-color: var(--card-light-gray-grad);
            margin-inline: 50px;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb {
            background-color: rgba(67, 5, 67, 1);
            border-radius: 10px;
            border: 2px solid yellow;
        }

        @media screen and ( max-aspect-ratio: 16/9 ) {

            ::-webkit-scrollbar {
                display: none;
            }
        }
    </style>
    
</head>
<body style="height: 100svh; width: 100vw; background: var(--background-color);">
    <header style="height: 10svh; width: 100vw; background-color: transparent; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--muted-gray);">
        <a href="/main" style="text-decoration: none; border: none; outline: none; margin-left: 5px; display: flex; align-items: center; justify-content: center;">
            <ion-icon name="arrow-round-back" style="font-weight: bold; color: var(--muted-gray); font-size: 2rem;"></ion-icon>
            <h1 style="text-decoration: none; margin-inline: 3px; font-weight: bold; font-family: 'Signika', sans-serif; font-size: 1.75rem; color: var(--muted-gray);">Public Bets</h1>
        </a>
        <div style="width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; margin-inline: 8px;">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 269.04 342.49">
                       <path d="M430.79 369.07a131.3 131.3 0 0 1 26.76 17c-.66-4-3.76-22.78-5.75-34.29 8.63 6 29.42 20.35 36.05 25 2.65-8.41 12.39-36.05 12.39-36.05s17.25 27.67 19.91 32.27c3.76-3.54 24.11-26.54 29.42-32.29 1.11 13.05 2 32.07 2.43 34.73a131.5 131.5 0 0 1 22.12-22.78c-5.75 11.28-8.41 26.76-9.73 39.37a147 147 0 0 0-40.7-5.75A150.8 150.8 0 0 0 448.92 406c-3.76-12.16-9.73-27.2-18.13-36.93m207.48 237.56-11.94-13.27c-3.32 35.61-21 66.14-53.09 87.37l-5.09-19.24c-27.43 19.69-74.1 32.29-114.36 9.73 5.09-25.44 9.29-51.32 0-82.28-22.34 34.29-42 48-42 48-15-25.44-13.71-76.09-9.29-91.13l-25 7.74c0-17 12.39-53.09 30.08-73.44l-15.26-2.43a148.3 148.3 0 0 1 46-54.64c-6 9.73-6 32.29 11.06 40.92-7.3-12.61-8-28.31-.66-36.72 7.74-8.41 20.35-5.31 28.31 1.11-2.43-7.08-9.73-15.93-19.91-16.59 19.91-10.4 43.13-15.93 67-15.93 4.65 0 9.07.44 13.27.66 7.08 2.65 17.25 12.61 22.12 19a35.1 35.1 0 0 0-3.76-15.93c26.1 6.41 38.71 17 43.8 22.12 1.11 11.28 4.42 17.92 9.07 28.76-8.41-9.29-29.64-24.77-40-28.31 0 0-1.11 9.73-4.42 14.38-20.35-14.6-30.08-18.36-30.08-18.36-22.56 2.21-36.5 11.06-44.46 17.7l6.64 5.75c-13.27 4-22.12 15.7-22.12 15.7 0 .44 11.94 2 11.94 2s-1.33 13.94 16.37 22.78c15 7.3 36.28-1.77 56.63 6.41-13.27-15.26-22.34-22.34-22.34-22.34a55.5 55.5 0 0 0-9.07-1.11c-4.65 0-11.72 1.11-19-2-3.76-1.33-8-4-11.06-6 0 0 9.29-9.73 23-11.72 0 0 12.39 3.32 22.12 10.62 6.41-6.41 13.27-6 13.27-6s-6.64 6.41-4.65 13.71a256 256 0 0 1 20.35 21c10.62-6 34.06-4.65 38.93 1.11-6-8-15-14.38-21.68-19.91-.66-3.1-8.41-13.27-9.29-14.38a45.9 45.9 0 0 1 13.27 7.74 16.85 16.85 0 0 1 9.73-6.41c4.65 4 5.75 10 5.31 11.06a12.84 12.84 0 0 1-4.42 3.76l11.28 12.39 1.11-9.07c26.27 37.48 40.65 81.06 22.29 135.69m-49.55-80.74v-19.24a61.8 61.8 0 0 1-17.92-10c-18.58 2.65-40.92 21.46-40.92 21.46s7.74 14.38 15.93 30.08c14.6 1.59 36.27-16.54 42.91-22.3m18.58 34.95a33.26 33.26 0 0 0-8-15.26L585 546s-19.69 16.59-31.41 17l10 18.58c6.64-1.33 17.92-6.64 22.78-11.94a68.4 68.4 0 0 1 2.43 21.68c6.55-4.15 15.62-14.32 18.5-30.48m6-63.7a148 148 0 0 1-13.3 9.73v19.24c5.31 5.75 10.4 10.62 14.38 19.24 7.3-12.82 5.53-32.06-1.11-48.21Z"
                             fill="var(--sport-green)" transform="translate(-377.48 -340.75)"/>
                </svg>
        </div>
        
    </header>

    
    <main style="height: 80svh; width: 100vw; padding: 5px 0 5px 10px; display: flex; flex-flow: column nowrap; align-items: flex-start; scroll-snap-type: inline mandatory; scroll-padding-inline: 10px; overflow-x: hidden; overflow-y: scroll;">
        
        <% parties.map((party) => { %>

            <% const totalPlayers = party.players.length %>
            <% const entry = party.amount %>
            <% const amountToSpread = totalPlayers * entry * 0.85 %>
            <% const first = amountToSpread * 0.6 %>
            <% const second = amountToSpread * 0.4 %>
            

            <section class="bet" style="position: relative; display: flex; flex-flow: column nowrap; margin-block: 20px; padding: 20px 10px 20px 10px; scroll-snap-align: start; width: clamp(250px, 80%, 800px); height: 68%; border-radius: 0 30px 0 30px; background-color: var(--card-bg-color); border: 2px solid var(--muted-gray);">
             
                <div class="heading" style="height: 10%; width: 100%; display: flex; justify-content: space-between; align-items: center;">
                    <h2 style="color: var(--text-white); font-size: 1.2rem; font-family: 'Signika', sans-serif; font-weight: bold;" >Public Party</h2>
                    <img src="logos/XtreamICON.png" alt="PL" width="30" height="30" />
                    <h2 style="color: var(--muted-gray); font-size: .85rem; font-family: 'Signika', sans-serif;">status: <span style="color: var(--neon-green); font-size: .95rem; font-weight: bold;">Active</span></h2>
    
                </div>
                <div class="gameweek" style="height: 10%; width: 100%; display: flex; justify-content: center; align-items: center;">
                    <h2 style="color: var(--muted-gray); font-size: 1.35rem; font-weight: bold; font-family: 'Signika', sans-serif;">Gameweek <span class="event"><%= party.event %></span></h2>
                </div>
                <div class="host-details" style="position: relative; height: 15%; margin-block: 5px; width: 100%; display: flex; flex-flow: column nowrap; justify-content: center; align-items: flex-start;">
                    <h2 style="color: var(--muted-gray); margin-bottom: 5px; font-family: 'Signika', sans-serif; font-size: 1.05rem; ">host: <span style="font-weight: bold; color: var(--text-white);">User<%= party.hostId %></span></h2>
                    <h2 style="color: var(--muted-gray); font-size: 1.25rem; font-family: 'Signika', sans-serif;">Totalplayers: <span style="font-weight: bold; color: var(--text-white);"><%= totalPlayers %></span></h2>
                    
                </div>
                <div class="winnings" style="height: 35%; width: 100%;">
                    <h2 style="color: var(--muted-gray); font-size: 1.1rem; margin-bottom: 10px; text-align: center;  font-weight: bold;  font-family: 'Signika', sans serif;">Possible Wins</h2>
    
                    <section class="winners-list" style="width: 100%; display: flex; flex-flow: column nowrap; justify-content: center; align-items: flex-start;">
    
                        <div class="first" style="display: flex; align-items: center; justify-content: center; margin-block: 5px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" style="fill: goldenrod;transform: msFilter"><path d="m21 2-5 5-4-5-4 5-5-5v13h18zM5 21h14a2 2 0 0 0 2-2v-2H3v2a2 2 0 0 0 2 2z"></path></svg>
                            <h2 style="font-size: 1.35rem;  margin-inline: 10px; font-weight: bold; font-family: 'Signika, sans-serif'; color: goldenrod;">1st: <span style="color: goldenrod; font-family: 'Signika', sans-serif;">KES.<%= first %></span></h2>
                        </div>
                        <div class="second" style="display: flex; align-items: center; justify-content: center; margin-block: 5px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" style="fill: var(--text-white); transform: msFilter"><path d="m21 2-5 5-4-5-4 5-5-5v13h18zM5 21h14a2 2 0 0 0 2-2v-2H3v2a2 2 0 0 0 2 2z"></path></svg>
                            <h2 style="font-size: 1.35rem;  margin-inline: 10px; font-weight: bold; font-family: 'Signika, sans-serif'; color: var(--text-white);">2nd: <span style="color: var(--text-white); font-family: 'Signika', sans-serif;">KES.<%= second %></span></h2>
                        </div>
                                
    
                    </section>
    
                </div>
                <div class="join-btn" style="height: 25%; width: 100%;  display: flex; flex-flow: column nowrap; justify-content: center; align-items: center;">
    
                    <h2 style=" font-family: 'Signika', sans-serif; text-align: center; margin-block: 10px; font-weight: bold; color: var(--muted-gray); font-size: 1.1rem;">Entry Amount: <span class="amount" style="color: var(--neon-green);">KES.<%= party.amount %></span></h2>
    
                    <a href="/party/<%= party._id %>" style="text-decoration: none; cursor: pointer; width: 75%; height: 60%; border: none; outline: none; padding: 15px; background-color: var(--sport-green); border-radius: 15px; color: var(--background-color); display: flex; justify-content: center; align-items: center;" >
                        <h2 style="font-size: 1.5rem;  font-family: 'Signika', sans-serif;">View Party</h2>
                    </a>
                    <h2 style="display: none; font-family: 'Signika', sans-serif; margin-top: 10px; font-weight: bold; color: var(--muted-gray); font-size: .85rem;">Party Code: <span class="code" style="color: var(--text-white);"><%= party._id %></span></h2>
                    
    
                </div>
                 
               <!-- HANGING LINKS -->
                <div class="links-wrapper" style="position: absolute; width: 15vw; height: 28%; bottom: 0; right: -70px; background-color: transparent; display: flex; flex-flow: column nowrap; justify-content: space-between; align-items: center;">
                    <!-- link to the specific party --> 
                    <a href="/party/<%= party._id %>" style="cursor: pointer;" ><svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" style="fill: var(--muted-gray); transform: msFilter"><path d="M19 11h-6V5h-2v6H5v2h6v6h2v-6h6z"></path></svg></a>
                
                    <button class="share" style="background-color: transparent; border: none; outline: none;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" style="fill: var(--muted-gray); transform: scaleX(-1); msFilter:progid:DXImageTransform.Microsoft.BasicImage(rotation=0, mirror=1);"><path d="M11 6.914V2.586L6.293 7.293l-3.774 3.774 3.841 3.201L11 18.135V13.9c8.146-.614 11 4.1 11 4.1 0-2.937-.242-5.985-2.551-8.293C16.765 7.022 12.878 6.832 11 6.914z"></path></svg>
                    </button>    
                </div>
            </section>


        <% }) %>

       
     

    </main>
    

    <footer style="height: 10svh; width: 100vw; background-color: transparent; border-top: 1px solid var(--muted-gray); display: flex; align-items: center; justify-content: center;">
        <div style="display: flex; align-items: center; justify-content: center; font-weight: bold; ">
            <h1 style="font-weight: 900; font-size: 1.2rem; color: var(--sport-green); font-family: 'Signika', sans-serif;">Xtream</h1>
            <div style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; margin-inline: 8px;">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 269.04 342.49">
                        <path d="M430.79 369.07a131.3 131.3 0 0 1 26.76 17c-.66-4-3.76-22.78-5.75-34.29 8.63 6 29.42 20.35 36.05 25 2.65-8.41 12.39-36.05 12.39-36.05s17.25 27.67 19.91 32.27c3.76-3.54 24.11-26.54 29.42-32.29 1.11 13.05 2 32.07 2.43 34.73a131.5 131.5 0 0 1 22.12-22.78c-5.75 11.28-8.41 26.76-9.73 39.37a147 147 0 0 0-40.7-5.75A150.8 150.8 0 0 0 448.92 406c-3.76-12.16-9.73-27.2-18.13-36.93m207.48 237.56-11.94-13.27c-3.32 35.61-21 66.14-53.09 87.37l-5.09-19.24c-27.43 19.69-74.1 32.29-114.36 9.73 5.09-25.44 9.29-51.32 0-82.28-22.34 34.29-42 48-42 48-15-25.44-13.71-76.09-9.29-91.13l-25 7.74c0-17 12.39-53.09 30.08-73.44l-15.26-2.43a148.3 148.3 0 0 1 46-54.64c-6 9.73-6 32.29 11.06 40.92-7.3-12.61-8-28.31-.66-36.72 7.74-8.41 20.35-5.31 28.31 1.11-2.43-7.08-9.73-15.93-19.91-16.59 19.91-10.4 43.13-15.93 67-15.93 4.65 0 9.07.44 13.27.66 7.08 2.65 17.25 12.61 22.12 19a35.1 35.1 0 0 0-3.76-15.93c26.1 6.41 38.71 17 43.8 22.12 1.11 11.28 4.42 17.92 9.07 28.76-8.41-9.29-29.64-24.77-40-28.31 0 0-1.11 9.73-4.42 14.38-20.35-14.6-30.08-18.36-30.08-18.36-22.56 2.21-36.5 11.06-44.46 17.7l6.64 5.75c-13.27 4-22.12 15.7-22.12 15.7 0 .44 11.94 2 11.94 2s-1.33 13.94 16.37 22.78c15 7.3 36.28-1.77 56.63 6.41-13.27-15.26-22.34-22.34-22.34-22.34a55.5 55.5 0 0 0-9.07-1.11c-4.65 0-11.72 1.11-19-2-3.76-1.33-8-4-11.06-6 0 0 9.29-9.73 23-11.72 0 0 12.39 3.32 22.12 10.62 6.41-6.41 13.27-6 13.27-6s-6.64 6.41-4.65 13.71a256 256 0 0 1 20.35 21c10.62-6 34.06-4.65 38.93 1.11-6-8-15-14.38-21.68-19.91-.66-3.1-8.41-13.27-9.29-14.38a45.9 45.9 0 0 1 13.27 7.74 16.85 16.85 0 0 1 9.73-6.41c4.65 4 5.75 10 5.31 11.06a12.84 12.84 0 0 1-4.42 3.76l11.28 12.39 1.11-9.07c26.27 37.48 40.65 81.06 22.29 135.69m-49.55-80.74v-19.24a61.8 61.8 0 0 1-17.92-10c-18.58 2.65-40.92 21.46-40.92 21.46s7.74 14.38 15.93 30.08c14.6 1.59 36.27-16.54 42.91-22.3m18.58 34.95a33.26 33.26 0 0 0-8-15.26L585 546s-19.69 16.59-31.41 17l10 18.58c6.64-1.33 17.92-6.64 22.78-11.94a68.4 68.4 0 0 1 2.43 21.68c6.55-4.15 15.62-14.32 18.5-30.48m6-63.7a148 148 0 0 1-13.3 9.73v19.24c5.31 5.75 10.4 10.62 14.38 19.24 7.3-12.82 5.53-32.06-1.11-48.21Z"
                             fill="var(--sport-green)" transform="translate(-377.48 -340.75)"/>
                      </svg>
            </div>
            <h1 style="font-weight: 900; font-size: 1.2rem; color: var(--sport-green); font-family: 'Signika', sans-serif;">League</h1>
        </div>

    </footer>

    <script>
        

        const betCards = document.querySelectorAll('.bet')
        
        betCards.forEach((betCard) => {

            const shareBtn  = betCard.children[5].children[1]
            const code = betCard.children[4].children[2].children[0].textContent
            const amount = betCard.children[4].children[0].children[0].textContent
            const betEvent = betCard.children[1].children[0].children[0].textContent

            shareBtn.addEventListener('click', () => {
    
                if (navigator.share) {
    
                    navigator.share({
                        title: 'PublicParty',
                        url: `https://xtreamleague.onrender.com/party/${code}`,
                        text:  `Hi there,\nJoin my Gameweek ${betEvent} party and compete with other FPL Managers. Entry fee is Ksh.${amount}\nuse link\nhttps://xtreamleague.onrender.com/party/${code}\nor use code\n${code}\nParty link:`
                    })
    
                } else {
                    navigator.clipboard.writeText(code)
                    window.alert('code copied to clipboard')
                }
            })
        })




    </script>
</body>
    

</html>